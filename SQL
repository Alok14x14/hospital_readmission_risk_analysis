-- ============================================================
-- HOSPITAL READMISSION RISK ANALYSIS
-- Dataset: Diabetes 130-US Hospitals (1999-2008), UCI ML Repository
-- Goal: Identify which patients/conditions drive 30-day readmission risk
-- ============================================================

CREATE DATABASE hospital_readmissions;
USE hospital_readmissions;

-- Quick sanity checks: confirm the raw table loaded correctly and
-- get a feel for the columns before doing any cleaning.
SELECT COUNT(*)
FROM diabetic_data_raw;

SELECT * FROM
diabetic_data_raw
LIMIT 10;

-- ============================================================
-- DATA CLEANING
-- ============================================================

-- STEP 1: Standardize missing values
-- The raw dataset encodes missing data as the string '?' instead of
-- a real SQL NULL. That breaks aggregate functions like COUNT(),
-- AVG(), and IS NULL checks, which all silently ignore '?' as if it
-- were valid data. Converting '?' to NULL makes missingness explicit
-- and lets built-in NULL-handling functions work correctly downstream.

-- diag_1 was originally typed too narrow for some ICD-9 codes;
-- widen it before writing any diagnosis codes into it.
ALTER TABLE diabetic_data_raw
    MODIFY diag_1 VARCHAR(10);

-- MySQL blocks UPDATEs without a key-based WHERE clause by default
-- (safe update mode). We're intentionally updating every row here,
-- so we disable that guardrail just for this operation.
SET SQL_SAFE_UPDATES = 0

UPDATE diabetic_data_raw
SET race = NULLIF(race, '?'),
	weight = NULLIF(weight, '?'),
    payer_code = NULLIF(payer_code, '?'),
    medical_specialty = NULLIF(medical_specialty, '?'),
    diag_1 = NULLIF(diag_1, '?'),
    diag_2 = NULLIF(diag_2, '?'),
    diag_3 = NULLIF(diag_3, '?');
    
-- optional: SET SQL_SAFE_UPDATES = 1

-- Quantify how much of each column is actually missing now that '?'
-- has been converted to NULL. This determines whether a column is
-- usable, needs imputation, or should be dropped entirely (see below:
-- weight/payer_code/medical_specialty turn out to be too sparse to use).
SELECT
	ROUND(SUM(weight IS NULL)/COUNT(*) * 100, 1) AS pct_missing_weight, 
	ROUND(SUM(payer_code IS NULL)/COUNT(*) * 100, 1) AS pct_missing_payer,
	ROUND(SUM(medical_specialty IS NULL)/COUNT(*) * 100, 1) AS pct_missing_specialty
FROM diabetic_data_raw;


-- STEP 2: Deduplicate to one encounter per patient
-- The same patient_nbr can appear multiple times (repeat hospital
-- visits). If left as-is, patients with many encounters would be
-- overrepresented and skew readmission rates upward. Checking first
-- how many patients have >1 encounter confirms this is a real issue
-- worth handling, not just a theoretical one.
SELECT
	patient_nbr, 
    COUNT(*) as encounter_count
FROM diabetic_data_raw
GROUP BY patient_nbr
HAVING COUNT(*) > 1
ORDER BY encounter_count DESC
LIMIT 10;

-- Keep only each patient's FIRST encounter (lowest encounter_id).
-- This gives one independent observation per patient, which is the
-- standard way to avoid within-patient correlation biasing the
-- analysis. A new deduplicated table is created rather than
-- overwriting the raw table, so the original data stays intact for
-- reference or re-processing.
CREATE TABLE diabetic_data_dedup AS
SELECT t.*
FROM diabetic_data_raw as t
INNER JOIN (SELECT 
	patient_nbr, 
    MIN(encounter_id) as first_encounter
FROM diabetic_data_raw
GROUP BY patient_nbr) first_enc
ON t.patient_nbr = first_enc.patient_nbr
AND t.encounter_id = first_enc.first_encounter;

-- Confirm the dedup worked and see how many unique patients remain.
 SELECT COUNT(*) FROM diabetic_data_dedup 
  
-- STEP 3: Remove encounters that can't be validly "readmitted"
-- Patients who were discharged to hospice or who died can't be
-- readmitted in the way the study defines risk — including them
-- would artificially inflate the "not readmitted" denominator and
-- distort every downstream rate calculation. First inspect discharge
-- disposition volumes, then find the specific codes that mean
-- hospice/expired/deceased, then remove those encounters.
SELECT 
	discharge_disposition_id, 
    COUNT(*) as encounter_count
FROM diabetic_data_raw
GROUP BY discharge_disposition_id
ORDER BY encounter_count DESC;
  
SELECT * FROM ids_mapping_raw
WHERE description LIKE '%hospice%' OR description LIKE '%expired%' OR description LIKE '%deceased%';
    
-- 11, 13, 14, 19, 20, 21, 26 = hospice / expired / unknown-invalid codes
DELETE FROM diabetic_data_dedup 
WHERE discharge_disposition_id IN (11, 13, 14, 19, 20, 21, 26);
    
-- STEP 4: Build lookup tables for coded IDs
-- discharge_disposition_id and admission_source_id are integer codes,
-- not human-readable text. The source ids_mapping_raw table mixes
-- multiple code types together in one table, which is error-prone to
-- join against. Splitting them into two clean, purpose-specific
-- mapping tables makes later JOINs unambiguous and the output
-- readable (e.g. "Discharged to home" instead of "1").
SELECT * FROM ids_mapping_raw;


CREATE TABLE discharge_disposition_map (
	discharge_disposition_id INT, 
    description VARCHAR(150)
);

CREATE TABLE admission_source_map (
	admission_source_id INT, 
    description VARCHAR(150)
);

