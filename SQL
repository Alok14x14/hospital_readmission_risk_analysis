-- STEP 5: Convert age brackets into a usable numeric value
-- age is stored as a text range like '[50-60)', which can't be
-- averaged, grouped numerically, or plotted directly. Adding a
-- numeric midpoint column (e.g. '[50-60)' -> 55) gives a continuous
-- proxy for age that later queries can aggregate and order by,
-- while still keeping the original bracket for readable grouping.
SELECT * FROM diabetic_data_dedup
LIMIT 50;

ALTER TABLE diabetic_data_dedup ADD COLUMN age_midpoint INT;

UPDATE diabetic_data_dedup
SET age_midpoint = CASE
    WHEN age = '[0-10)'   THEN 5
    WHEN age = '[10-20)'  THEN 15
    WHEN age = '[20-30)'  THEN 25
    WHEN age = '[30-40)'  THEN 35
    WHEN age = '[40-50)'  THEN 45
    WHEN age = '[50-60)'  THEN 55
    WHEN age = '[60-70)'  THEN 65
    WHEN age = '[70-80)'  THEN 75
    WHEN age = '[80-90)'  THEN 85
    WHEN age = '[90-100)' THEN 95
END;

-- ============================================================
-- EXPLORATORY ANALYSIS
-- Establish baseline readmission rates before doing anything advanced,
-- so later "high risk" claims have a benchmark to compare against.
-- ============================================================

-- Overall breakdown of the target variable: what fraction of
-- encounters are readmitted <30 days, >30 days, or not at all.
-- This baseline rate is the number every later subgroup rate gets
-- compared to.
SELECT
	readmitted, 
    COUNT(*) as encounter_count, 
    ROUND(COUNT(*) / (SELECT COUNT(*) FROM diabetic_data_dedup) * 100, 1) as pct_of_total 
FROM diabetic_data_dedup
GROUP BY readmitted
ORDER BY encounter_count DESC;
	
-- Readmission rate by age bracket, ordered by the numeric midpoint
-- (not alphabetically by the text label) so the trend across age is
-- actually readable.
SELECT
	age, 
    age_midpoint, 
    COUNT(*) as total_encounters, 
    SUM(readmitted = '<30') as readmitted_under_30,
    ROUND(SUM(readmitted = '<30') / COUNT(*) * 100, 1) as readmission_rate_pct
FROM diabetic_data_dedup
GROUP BY age, age_midpoint
ORDER BY age_midpoint;

-- Readmission rate by admission type (emergency, elective, urgent,
-- etc.), joining to the mapping table so the output shows readable
-- labels instead of raw ID codes.
SELECT
	m.description as admission_type, 
    COUNT(*) as total_encounters, 
    ROUND(SUM(d.readmitted = '<30') / COUNT(*) * 100, 1) as readmission_rate_pct
FROM diabetic_data_dedup AS d
JOIN ids_mapping_raw AS m
ON d.admission_type_id = m.admission_type_id
GROUP BY m.description
ORDER BY readmission_rate_pct DESC;



-- ============================================================
-- ADVANCED TECHNIQUES
-- ============================================================

-- Build a reusable "base" CTE that selects the core risk-relevant
-- columns and derives a clean 0/1 flag for 30-day readmission
-- (CASE WHEN...THEN 1 ELSE 0). Doing this once as a CTE means every
-- later query can reference the same is_readmitted_30 definition
-- instead of re-deriving it and risking inconsistent logic.
WITH patient_risk_base AS (
	SELECT
		encounter_id, 
        patient_nbr, 
        age_midpoint, 
        time_in_hospital, 
        num_medications, 
        num_lab_procedures, 
        number_diagnoses, 
        number_inpatient, 
        number_emergency, 
        number_outpatient, 
        diag_1, 
        readmitted, 
        CASE WHEN readmitted = '<30' THEN 1 ELSE 0 END AS is_readmitted_30
	FROM diabetic_data_dedup
)
SELECT * FROM patient_risk_base
LIMIT 20;


-- RANK() ranks each patient's medication count WITHIN their age
-- group (PARTITION BY age_midpoint), rather than across the whole
-- population. This answers "who has the heaviest medication burden
-- for their age?" rather than just "who takes the most medications
-- overall" — a 30-year-old and an 80-year-old aren't comparable on
-- raw medication count alone.
WITH patient_risk_base AS (
	SELECT 
		encounter_id, age_midpoint, num_medications, readmitted, 
        CASE WHEN readmitted = '<30' THEN 1 ELSE 0 END AS is_readmitted_30
	FROM diabetic_data_dedup
)
SELECT
	encounter_id, 
    age_midpoint, 
    num_medications, 
    RANK() OVER (PARTITION BY age_midpoint ORDER BY num_medications DESC) as med_rank_age_group
FROM patient_risk_base
ORDER BY age_midpoint, med_rank_age_group
LIMIT 200;


-- NTILE(4) splits the entire patient population into 4 equal-sized
-- groups (quartiles) ordered by number_inpatient (prior inpatient
-- visits) descending. Unlike RANK, this guarantees evenly sized
-- buckets — useful for operational triage, e.g. "flag quartile 1
-- for extra discharge follow-up" regardless of how the underlying
-- values are distributed.
WITH patient_risk_base AS (
	SELECT 
		encounter_id, number_inpatient, readmitted, 
        CASE WHEN readmitted = '<30' THEN 1 ELSE 0 END AS is_readmitted_30
     FROM diabetic_data_dedup
)
SELECT
	encounter_id, 
    number_inpatient, 
    NTILE(4) OVER (ORDER BY number_inpatient DESC) as risk_quartile
FROM patient_risk_base;


-- Convert two continuous variables (medication count, diagnosis
-- count) into business-readable risk tiers using CASE. Raw numbers
-- like "14 medications" mean little to a non-technical audience;
-- labeling it "Medium burden" makes the output usable by care teams
-- without a data background.
SELECT
	encounter_id, 
    num_medications, 
    CASE
		WHEN num_medications <= 10 THEN 'Low'
        WHEN num_medications BETWEEN 11 AND 20 THEN 'Medium'
        ELSE 'HIGH'
	END AS medication_burden_tier, 
    CASE
		WHEN number_diagnoses <= 5 THEN 'Low Complexity'
        WHEN number_diagnoses BETWEEN 6 AND 9 THEN 'Moderate Complexity'
        ELSE 'High Complexity'
	END AS diagnosis_complexity_tier
FROM diabetic_data_dedup;



-- diag_1 stores raw ICD-9 diagnosis codes as text, not category
-- names. The comment block below documents the ICD-9 numeric ranges
-- used to bucket diag_1 into clinically meaningful categories, since
-- these boundaries aren't self-explanatory from the codes alone.
-- diag_1 notes
-- 390–459: Diseases of the circulatory system
-- 460–519: Diseases of the respiratory system
-- 520–579: Diseases of the digestive system
-- 580–629: Diseases of the genitourinary system
-- 800–999: Injury and poisoning

-- Categorize each encounter's primary diagnosis into a clinical
-- bucket (CAST + LEFT to pull the numeric ICD-9 prefix out of the
-- text code and range-match it), then use a correlated subquery in
-- HAVING to keep only categories whose readmission rate is ABOVE the
-- population-wide average. The subquery must be correlated (i.e.
-- recomputed against the CTE) rather than a one-time value, because
-- HAVING evaluates it per group in the context of the same
-- diag_categorized result set being aggregated.
WITH diag_categorized AS (
	SELECT
		encounter_id, 
        readmitted, 
        CASE
			WHEN diag_1 LIKE '250%' THEN 'Diabetes'
            WHEN CAST(LEFT(diag_1, 3) AS UNSIGNED) BETWEEN 390 AND 459 THEN 'CIRCULATORY'
			WHEN CAST(LEFT(diag_1, 3) AS UNSIGNED) BETWEEN 460 AND 519 THEN 'Respiratory'
            WHEN CAST(LEFT(diag_1, 3) AS UNSIGNED) BETWEEN 520 AND 579 THEN 'Digestive'
            WHEN CAST(LEFT(diag_1, 3) AS UNSIGNED) BETWEEN 580 AND 629 THEN 'Genitourinary'
            WHEN CAST(LEFT(diag_1, 3) AS UNSIGNED) BETWEEN 800 AND 999 THEN 'Injury'
		ELSE 'Other'
	END AS diagnosis_cateogry, 
    CASE WHEN readmitted = '<30' THEN 1 ELSE 0 END AS is_readmitted_30
	FROM diabetic_data_dedup
    WHERE diag_1 IS NOT NULL
)
SELECT
	diagnosis_cateogry, 
    COUNT(*) AS total_encounters, 
    ROUND(AVG(is_readmitted_30) * 100, 1) AS readmission_rate_pct
FROM diag_categorized
GROUP BY diagnosis_cateogry
HAVING AVG(is_readmitted_30) > (
	SELECT AVG(is_readmitted_30) FROM diag_categorized
)
ORDER BY readmission_rate_pct DESC;


-- ============================================================
-- KEY FINDINGS
-- Each block below answers one specific business question raised
-- during EDA, tying the SQL directly back to an actionable insight.
-- ============================================================

-- Finding 1. Top diagnosis categories driving readmission
-- (see the diag_categorized query above)

-- Finding 2. Does a medication change at discharge affect readmission?
-- Compares readmission rate for encounters where medication was
-- changed ('Ch') vs not ('No') at discharge, to see if the
-- intervention itself correlates with outcome.
SELECT
	`change`, 
    COUNT(*) as total_encounters,
	ROUND(SUM(readmitted = '<30') / COUNT(*) * 100, 1) AS readmission_rate_pct
FROM diabetic_data_dedup
GROUP BY `change`;


-- Finding 3. Discharge disposition impact
-- Joins to the discharge_disposition_map built earlier for readable
-- labels, and filters to dispositions with >100 encounters (HAVING)
-- so small, noisy categories don't produce misleadingly extreme
-- rates from a handful of cases.
SELECT
	m.description as discharge_disposition, 
    COUNT(*) AS total_encounters, 
	ROUND(SUM(d.readmitted = '<30') / COUNT(*) * 100, 1) AS readmission_rate_pct
FROM diabetic_data_dedup as d
JOIN discharge_disposition_map as m
ON d.discharge_disposition_id = m.discharge_disposition_id
GROUP BY m.description
HAVING COUNT(*) > 100
ORDER BY readmission_rate_pct DESC
LIMIT 10;



-- Finding 4. A1C testing and readmission
-- Checks whether patients who received an A1C test (and its result)
-- have different readmission rates than those who weren't tested,
-- since this maps to a specific clinical recommendation in the
-- original research behind this dataset.
SELECT
	A1Cresult, 
    COUNT(*) as total_encounters, 
	ROUND(SUM(readmitted = '<30') / COUNT(*) * 100, 1) AS readmission_rate_pct
FROM diabetic_data_dedup
GROUP BY A1Cresult;
